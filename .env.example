APP_NAME=VeggieMap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docker-compose 的服務名稱即 host，本機不跑 Docker 時改成 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=veggiemap
DB_USERNAME=veggiemap
DB_PASSWORD=veggiemap

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# 見 docs/architecture.md：搜尋快取／詳情快取／Rate Limit／Queue 都走 Redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=veggiemap_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@veggiemap.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- VeggieMap：外部資料源設定（見 docs/external-apis.md） ---
# Overpass：離線批次匯入用（php artisan restaurants:sync），非即時查詢路徑
# 斷路器：連續失敗達門檻後，冷卻時間內的請求直接短路，不再空等逾時＋重試。
# 排程一次跑五個城市 bbox（五個獨立程序），所以狀態存在 Redis 而不是程序記憶體。
EXTERNAL_API_CIRCUIT_FAILURE_THRESHOLD=5
EXTERNAL_API_CIRCUIT_COOLDOWN_SECONDS=600

EXTERNAL_API_OVERPASS_URL=https://overpass-api.de/api/interpreter
EXTERNAL_API_OVERPASS_TIMEOUT=30
# 必填：overpass-api.de 會用 HTTP 406 擋掉 Guzzle 預設 User-Agent。留空則沿用下面
# Nominatim 那組識別字串（見 config/services.php）。
EXTERNAL_API_OVERPASS_USER_AGENT=
# Nominatim：使用者主動地址搜尋才呼叫，需帶合法 User-Agent，每秒最多 1 次
EXTERNAL_API_NOMINATIM_URL=https://nominatim.openstreetmap.org
EXTERNAL_API_NOMINATIM_USER_AGENT="VeggieMap/1.0 (+https://github.com/thothawei/veggie-map)"
# 開發/離線環境用：restaurants:sync 抓不到 Overpass 時的保底
EXTERNAL_API_RESTAURANT_PROVIDER=mock
# 每組格式 "minLat,minLng,maxLat,maxLng@收錄規則"，多組用分號分隔，@規則可省略（預設 only）。
# 規則名稱必須是 config/diet.php sync_modes 的 key（目前 only／yes）。
# only=只收純素食店，yes=連「有素食選項」的餐廳一起收。yes 進來的友善店會標成 friendly，
# 不會看起來像素食餐廳；前端預設 venue_scope=exclusive，地圖不會一進來全是火鍋。
# 2026-08-25 Phase B：台灣四市與東京都用 yes。留空代表不排程自動匯入。
EXTERNAL_API_SYNC_BBOXES="24.9613,121.4570,25.2130,121.6663@yes;23.9500,120.4300,24.4500,121.4700@yes;22.4500,120.1500,23.3000,121.0600@yes;22.8500,120.0000,23.4500,120.7000@yes;35.5300,139.5600,35.8200,139.9200@yes"

# --- AI Office 子系統（見 docs/implementation-plan.md） ---
# LLM provider：mock｜claude。預設 mock，理由同 EXTERNAL_API_RESTAURANT_PROVIDER——
# 開發／測試環境不該因為忘了設定就真的打出去燒 token。
AI_OFFICE_LLM_PROVIDER=mock
AI_OFFICE_CLAUDE_MODEL=claude-opus-5
AI_OFFICE_CLAUDE_MAX_TOKENS=16000
AI_OFFICE_LLM_TIMEOUT=120
# 只從環境變數讀，不進資料庫、不寫進 log。.env 不要 commit。
ANTHROPIC_API_KEY=
# Agent loop 硬上限，撞到就中止任務（規格第 26 節）
AI_OFFICE_MAX_AGENT_STEPS=25
AI_OFFICE_MAX_TOOL_CALLS=50
AI_OFFICE_MAX_RETRIES=3
AI_OFFICE_MAX_TOKEN_BUDGET=200000
# 沙箱：true 代表「要求沙箱」。SandboxManager 尚未實作前，TerminalTool 會直接拒絕
# 執行而不是退回在 host 上跑。留空／false 等於把 host shell 交給 LLM，別在共用機器上這樣設。
AI_OFFICE_SANDBOX_ENABLED=true
AI_OFFICE_SANDBOX_TIMEOUT=60
AI_OFFICE_SANDBOX_MEMORY_MB=512
AI_OFFICE_SANDBOX_CPU_LIMIT=1.0
AI_OFFICE_SANDBOX_NETWORK=none
# Phase 11：指令真的丟進容器跑。docker CLI／socket 不可用時 SandboxManager 會回報
# unavailable，TerminalTool 維持拒絕執行，不會退回在 host 上跑。
AI_OFFICE_SANDBOX_DOCKER=docker
AI_OFFICE_SANDBOX_IMAGE=alpine:3.20
AI_OFFICE_SANDBOX_USER=1000:1000
AI_OFFICE_SANDBOX_PIDS=128
AI_OFFICE_SANDBOX_READONLY=true
AI_OFFICE_SANDBOX_TMPFS_MB=64
# 讓 Agent 能建立／啟動容器是另一個層級的權限，預設關閉。
AI_OFFICE_SANDBOX_DOCKER_TOOL=false
# Agent 產出的檔案根目錄；WorkspaceGuard 唯一認可的邊界起點。留空用 base_path('workspace')。
AI_OFFICE_WORKSPACE_ROOT=
# 跟餐廳評分那些 Job 分開排隊，避免長跑的 Agent loop 卡住評分重算
AI_OFFICE_QUEUE=ai-office
# CEO 規劃：角色／重試次數讀 config，不寫死 ceo。Job timeout 必須比 LLM timeout 長。
AI_OFFICE_PLANNER_ROLE=ceo
AI_OFFICE_PLANNER_MAX_ATTEMPTS=3
AI_OFFICE_JOB_TIMEOUT=300
AI_OFFICE_RETRY_DELAY=10
# 風險門檻：low／medium／high／critical／off。此級（含）以上即使權限是 allow 也要人工核准。
# critical 一定要核准。off = 只強制 critical，其餘看 Agent 權限。
# Agent 記憶（規格 §41）。recall_limit 直接影響每次請求的 prompt 長度與成本。
AI_OFFICE_MEMORY_ENABLED=true
AI_OFFICE_MEMORY_RECALL_LIMIT=5
AI_OFFICE_MEMORY_MAX_LENGTH=1000

# 事件流 SSE（規格 §36）。連線壽命與每人連線數是為了避免長連線吃光 PHP-FPM worker。
AI_OFFICE_SSE_POLL_MS=1000
AI_OFFICE_SSE_MAX_SECONDS=60
AI_OFFICE_SSE_MAX_CONNECTIONS=3
AI_OFFICE_SSE_BATCH=100
AI_OFFICE_SSE_TICKET_TTL=60

AI_OFFICE_APPROVAL_THRESHOLD=high
AI_OFFICE_APPROVAL_TTL_HOURS=24

VITE_APP_NAME="${APP_NAME}"

# API 文件頁 /docs（Redoc）。預設只在非 production 開——關掉不是為了保密，
# 而是不要在正式站放一個沒有人維護的頁面。
VEGGIEMAP_DOCS_ENABLED=true

# 慢請求門檻（毫秒）。超過就寫一筆 warning log；每筆回應都會帶 X-Response-Time-Ms。
VEGGIEMAP_SLOW_REQUEST_MS=1000

# 搜尋建議（自動完成）的每分鐘上限。跟一般 API 的 60/分鐘分開算。
VEGGIEMAP_SUGGEST_RATE_LIMIT=180

# 慢查詢門檻（毫秒）。超過就寫 warning log（含 route，不含 bindings）。0 以下＝關掉。
VEGGIEMAP_SLOW_QUERY_MS=200

# Cache 命中率統計（php artisan cache:stats）。每次 hit/miss 多一次 Redis 寫入。
VEGGIEMAP_CACHE_STATS=true

# 誰能在非 local 環境開 /horizon 與 /telescope。逗號分隔的 email，空的＝沒有人。
# 這兩個頁面看得到佇列 payload、SQL bindings 與請求內文，不要隨便加人。
DASHBOARD_ALLOWED_EMAILS=
