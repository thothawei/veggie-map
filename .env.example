APP_NAME=VeggieMap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docker-compose 的服務名稱即 host，本機不跑 Docker 時改成 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=veggiemap
DB_USERNAME=veggiemap
DB_PASSWORD=veggiemap

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# 見 docs/architecture.md：搜尋快取／詳情快取／Rate Limit／Queue 都走 Redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=veggiemap_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@veggiemap.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- VeggieMap：外部資料源設定（見 docs/external-apis.md） ---
# Overpass：離線批次匯入用（php artisan restaurants:sync），非即時查詢路徑
EXTERNAL_API_OVERPASS_URL=https://overpass-api.de/api/interpreter
EXTERNAL_API_OVERPASS_TIMEOUT=30
# 必填：overpass-api.de 會用 HTTP 406 擋掉 Guzzle 預設 User-Agent。留空則沿用下面
# Nominatim 那組識別字串（見 config/services.php）。
EXTERNAL_API_OVERPASS_USER_AGENT=
# Nominatim：使用者主動地址搜尋才呼叫，需帶合法 User-Agent，每秒最多 1 次
EXTERNAL_API_NOMINATIM_URL=https://nominatim.openstreetmap.org
EXTERNAL_API_NOMINATIM_USER_AGENT="VeggieMap/1.0 (+https://github.com/thothawei/veggie-map)"
# 開發/離線環境用：restaurants:sync 抓不到 Overpass 時的保底
EXTERNAL_API_RESTAURANT_PROVIDER=mock
# routes/console.php 排程 restaurants:sync 要用，格式 "minLat,minLng,maxLat,maxLng"，
# 多組 bbox 用分號分隔。留空代表不排程自動匯入。預設台北市行政區範圍（2026-08-25 決定）。
EXTERNAL_API_SYNC_BBOXES=24.9613,121.4570,25.2130,121.6663

VITE_APP_NAME="${APP_NAME}"
