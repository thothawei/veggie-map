<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            schema 用 MySQL 專屬的空間函式（POINT／ST_Distance_Sphere／MBRContains，
            見 App\Repositories\RestaurantRepository），sqlite 跑不起來，改連同一個
            Docker MySQL 的獨立測試庫，不碰 veggiemap 開發資料。
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="mysql"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="veggiemap_testing"/>
        <env name="DB_USERNAME" value="veggiemap"/>
        <env name="DB_PASSWORD" value="veggiemap"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <!--
          慢查詢 log 在測試裡幾乎全是雜訊：migration 的 drop table、RefreshDatabase、
          以及併發測試刻意製造的鎖等待都會超過門檻（實測 69 筆裡沒有一筆是應用程式
          的問題）。留著只會把真正的慢查詢埋掉，還讓每次測試多做一堆 Log::warning。
          0 以下＝關掉（見 config/veggiemap.php）。ObservabilityTest 直接呼叫
          QueryPerformanceLogger::handle() 驗證邏輯，不靠這個監聽器。
        -->
        <env name="VEGGIEMAP_SLOW_QUERY_MS" value="0"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
